# ---- Your mailbox ----
MAIL_USER=you@gmail.com
# Gmail/Yahoo/iCloud/ukr.net: use an APP PASSWORD, not your normal password (see README)
MAIL_PASSWORD=
MAIL_FROM_NAME=Your Name

# ---- Access key for the phone app and for Claude ----
# Generate: openssl rand -hex 24
MAIL_APP_TOKEN=

# ---- Only needed if your provider is not auto-detected ----
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465        # 587 = STARTTLS

# ---- Options ----
# PORT=8787
# MCP_READ_ONLY=1      # Claude can read but not send/move/delete
# SAVE_SENT=auto       # auto | always | never  (copy sent mail into Sent via IMAP)
