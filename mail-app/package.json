{
  "name": "pocket-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Outlook-style mail app (PWA) with an MCP server so Claude can read and send your mail",
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "MAIL_DEMO=1 bun --watch server/index.ts",
    "demo": "MAIL_DEMO=1 bun server/index.ts",
    "mcp": "bun server/mcp-stdio.ts",
    "test": "bun test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
